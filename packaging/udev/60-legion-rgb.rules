# Lenovo Legion / IdeaPad Gaming 4-zone RGB keyboard (ITE 8295).
# Grants the active desktop user access to the vendor hidraw node so the GUI
# and the legion-lightd user service can write feature reports without root.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="048d", ATTRS{idProduct}=="c955", TAG+="uaccess"
